{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lecture7-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "lecture 7/frontend"
      ],
      "port": 5173
    },
    {
      "name": "lecture7-backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd 'lecture 7/backend' && ./.venv/bin/uvicorn main:app --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "lecture8-backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd 'lecture 8/backend' && ./.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "lecture8-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "lecture 8/frontend"
      ],
      "port": 5173
    }
  ]
}
