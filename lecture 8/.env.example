# Copy to .env in this folder (or the parent course folder) and fill in.
# main.py loads both: lecture 8/.env and the parent folder's .env
# Never commit the real .env.

PORTKEY_API_KEY=your_portkey_key_here

# Signs login tokens. Any long random string, e.g.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random one is used and everyone is signed out on restart.
SECRET_KEY=change_me

# Optional
# DB_PATH=data/app.db                 # runtime database (copied from data/yale_som.db)
# CORS_ORIGINS=https://your-site.onrender.com   # default * (open)
